# Copy to .env.local (never commit it). Same names go into Vercel → Project → Settings → Environment Variables.
# Supabase Dashboard → Project Settings → API Keys.

# Browser (public): Project URL + publishable key (sb_publishable_...). Only used to receive Realtime broadcasts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only (api/room.ts): secret key (sb_secret_...). Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
